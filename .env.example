# Public website URL — leave blank on previews. Set after the final HTTPS domain is connected.
# Canonical production origin (domain purchased; hosting/DNS must still be connected).
NEXT_PUBLIC_SITE_URL=https://vecuniverse.com

# Keep false or unset until the final domain is connected and launch is approved.
# Keep false until the live site, HTTPS, redirects, and content have been checked.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Optional Google Search Console verification token (added after domain verification).
GOOGLE_SITE_VERIFICATION=

# Public social links — add the full official HTTPS profile URL when each account is created.
# The matching icons remain visible even while these values are blank.
# Update config/site.ts for local source defaults, or set these variables in Netlify for production.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@VECUniverse
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=917846867395
NEXT_PUBLIC_CONTACT_EMAIL=vec.curiomaya@gmail.com

# Optional media CDN base for large video assets
NEXT_PUBLIC_MEDIA_BASE_URL=

# Sanity CMS — project ID and dataset are public identifiers, not secrets.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only enquiry delivery (never prefix secrets with NEXT_PUBLIC_)
RESEND_API_KEY=
VEC_RECEIVE_EMAIL=vec.curiomaya@gmail.com
VEC_FROM_EMAIL=website@your-verified-domain.com

# Optional GA4 Measurement ID (G-XXXXXXXXXX). Analytics stays off until a visitor opts in.
NEXT_PUBLIC_GA4_ID=
